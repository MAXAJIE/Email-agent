diff -ruN '--exclude=.git' '--exclude=.pytest_cache' '--exclude=.openminion' '--exclude=__pycache__' base/mailkeep/understand.py w/mailkeep/understand.py
--- a/mailkeep/understand.py	2026-10-21 04:08:59.213803143 +0000
+++ b/mailkeep/understand.py	2026-10-21 04:08:02.456563123 +0000
@@ -344,3 +344,51 @@
     if not chosen:
         return None
     return f"{verb} {_compact(chosen)}", sorted(kept)
+
+
+_KEEP_MORE = re.compile(
+    r"\b(not (?:a )?(?:trash|junk|spam)|isn'?t (?:trash|junk)|is useful|are useful|important|"
+    r"keep|don'?t (?:trash|delete|archive|remove)|do not (?:trash|delete|archive|remove)|"
+    r"leave|save|exclude|skip|spare|need (?:it|them|this)|也保留|保留|不是垃圾|别删|不要删)\b", re.I)
+_DROP_MORE = re.compile(r"\b(also|too|as well|and)\b.*\b(trash|delete|archive|remove|bin)\b|"
+                        r"\b(trash|delete|archive|remove|bin)\b.*\b(too|as well|also)\b", re.I)
+
+
+def _named_rows(text: str, rows: list) -> set[int]:
+    low = text.lower()
+    words = set(re.findall(r"[\w\u00c0-\uffff]+", low))
+    hits: set[int] = set()
+    for index, email in enumerate(rows, start=1):
+        sender = str(getattr(email, "sender", "") or "").lower()
+        names = {w for w in re.findall(r"[\w\u00c0-\uffff]+", sender) if len(w) >= 3 and w not in _STOP}
+        if names & words:
+            hits.add(index)
+    for a, b in re.findall(r"#?\b(\d{1,3})\b(?:\s*(?:-|to)\s*(\d{1,3}))?", low):
+        for n in range(int(a), int(b or a) + 1):
+            if 1 <= n <= len(rows):
+                hits.add(n)
+    return hits
+
+
+def refine_selection(text: str, rows: list, kept: list[int], verb: str) -> tuple[str, list[int]] | None:
+    """Follow-up on a pending 'trash the rest' card: 'shopee is not trash' adds
+    Shopee to the kept rows (earlier kept rows stay kept); 'trash github too'
+    removes it. Returns (new command, kept rows) or None."""
+    if not rows or not text or EMAIL_RE.search(text):
+        return None
+    named = _named_rows(text, rows)
+    if not named:
+        return None
+    keep = set(kept)
+    if _KEEP_MORE.search(text):
+        keep |= named
+    elif _DROP_MORE.search(text):
+        keep -= named
+    else:
+        return None
+    if keep == set(kept):
+        return None
+    chosen = [n for n in range(1, len(rows) + 1) if n not in keep]
+    if not chosen:
+        return None
+    return f"{verb} {_compact(chosen)}", sorted(keep)
diff -ruN '--exclude=.git' '--exclude=.pytest_cache' '--exclude=.openminion' '--exclude=__pycache__' base/tests/test_memory_and_lists.py w/tests/test_memory_and_lists.py
--- a/tests/test_memory_and_lists.py	2026-10-21 04:08:59.343267081 +0000
+++ b/tests/test_memory_and_lists.py	2026-10-21 04:08:38.891114231 +0000
@@ -47,3 +47,45 @@
 
 def test_cjk_tokens_counted_per_char():
     assert understand.estimate_tokens("记住上下文") == 5
+
+
+def test_refine_keeps_earlier_kept_rows():
+    cmd, kept = understand.list_selection("google and github is not trash, move other into trash", ROWS)
+    assert kept == [7, 9, 10] and cmd == "delete 1-6,8"
+    cmd, kept = understand.refine_selection("shopee is not trash", ROWS, kept, "delete")
+    assert kept == [7, 8, 9, 10] and cmd == "delete 1-6"
+
+
+def test_refine_trash_one_more():
+    cmd, kept = understand.refine_selection("trash github too", ROWS, [7, 9, 10], "delete")
+    assert kept == [7, 10] and cmd == "delete 1-6,8-9"
+
+
+def test_refine_by_number_and_unrelated_text():
+    cmd, kept = understand.refine_selection("keep 5 as well", ROWS, [9, 10], "delete")
+    assert kept == [5, 9, 10] and cmd == "delete 1-4,6-8"
+    assert understand.refine_selection("looks good", ROWS, [9, 10], "delete") is None
+
+
+def test_agent_followup_refines_pending_card(monkeypatch):
+    from mailkeep import agent as agent_mod, llm
+    from mailkeep.demo import DemoGmailClient
+    from mailkeep.session import Session
+    monkeypatch.setattr(agent_mod, "resolve_mode", lambda: ("rules", "test"))
+    monkeypatch.setattr(llm, "describe", lambda: [])
+    monkeypatch.setattr(agent_mod, "trace", lambda kind, text: None)
+    agent = agent_mod.MailkeepAgent(Session(DemoGmailClient()))
+    agent.session.run_command("find in:inbox limit 6")
+    rows = agent.session.assistant.last_results
+    assert len(rows) >= 4
+    first = str(rows[0].sender).split()[-1]
+    second = str(rows[1].sender).split()[-1]
+    agent.chat(f"keep {first}, trash the others")
+    kept1 = list(agent._selection["kept"])
+    assert 1 in kept1
+    if second.lower() in first.lower():
+        return
+    agent.chat(f"{second} is not trash")
+    kept2 = agent._selection["kept"]
+    assert set(kept1) < set(kept2) and 2 in kept2
+    assert agent.session.approval is agent._selection["approval"]
