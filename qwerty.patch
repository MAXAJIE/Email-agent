+def env_values() -> dict[str, str]:
+    """Merged view of all env files (earlier files win). Values are secrets."""
+    merged: dict[str, str] = {}
+    for path in env_files():
+        for key, value in load_env_file(path).items():
+            if value and key not in merged:
+                merged[key] = value
+    return merged
 
 
