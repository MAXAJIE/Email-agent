+    if custom:
+        files.append(Path(custom).expanduser())
+    files += [ENV_FILE, FALLBACK_ENV_FILE, *EXTRA_ENV_FILES, *DOTENV_FILES]
+    seen: set[Path] = set()
+    unique = []
+    for f in files:
+        if f not in seen:
+            seen.add(f)
+            unique.append(f)
+    return tuple(unique)
