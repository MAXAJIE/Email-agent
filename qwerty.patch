+
+
+# Verbs that change mailbox state. Kept broad on purpose: the score, not any
+# single word, decides, and read-only verbs pull it back down.
+_ACTION_VERBS = (
+    "change", "modify", "update", "rename", "edit", "archive", "delete",
+    "remove", "label", "unlabel", "mark", "move", "restore", "trash",
+    "star", "unstar", "mute", "snooze", "forward", "send", "reply", "draft",
+    "compose", "clean", "clear", "organize", "organise", "fix",
+)
+_READ_ONLY = (
+    "find", "search", "show", "list", "open", "read", "what", "which", "how",
+    "summarize", "summarise", "analyze", "analyse", "explain", "tell",
+)
+
+
+def action_intent(text: str) -> float:
+    """Confidence 0..1 that the message asks for a mailbox-changing action.
+
+    Weighted cues, not a single keyword: an action verb is the base, row
+    references and mailbox targets raise it, question marks and read-only
+    verbs lower it. Compare against action_threshold().
+    """
+    import re
+
+    words = text.lower()
+    score = 0.0
+    verbs = sum(1 for v in _ACTION_VERBS if re.search(rf"\b{re.escape(v)}\b", words))
+    if verbs:
+        score += 0.45 + 0.1 * min(verbs - 1, 2)
+    if re.search(r"\b\d+([,-]\s*\d+)*\b", words):
+        score += 0.2  # a row reference ("archive 1,3")
+    if re.search(r"\b(emails?|mails?|mailbox|messages?|inbox|newsletters?|label|subject|sender)\b", words):
+        score += 0.15
+    if re.search(r"\b(all|every|each)\b", words):
+        score += 0.1
+    if "?" in text:
+        score -= 0.25
+    if any(re.search(rf"\b{re.escape(v)}\b", words) for v in _READ_ONLY):
+        score -= 0.4
+    return max(0.0, min(1.0, score))
+
+
+def action_threshold() -> float:
+    """Confidence at which a message is treated as an action request (0..1)."""
+    raw = setting("MAILKEEP_ACTION_THRESHOLD")
+    try:
+        value = float(raw) if raw else 0.6
+    except ValueError:
+        raise ValueError("MAILKEEP_ACTION_THRESHOLD must be a number from 0 to 1") from None
+    if not 0.0 <= value <= 1.0:
+        raise ValueError("MAILKEEP_ACTION_THRESHOLD must be from 0 to 1")
+    return value
+
+
+# Mailbox vocabulary for the topic guard. Mailkeep is a Gmail assistant;
+# a message with none of these terms and a clear non-mailbox intent is
+# refused instantly instead of spending a model call on it.
+_MAILBOX_TERMS = (
+    "mail", "email", "e-mail", "inbox", "gmail", "message", "draft",
+    "reply", "sender", "subject", "newsletter", "spam", "trash", "label",
+    "archive", "attachment", "unread", "snooze", "mute", "star",
+    "invoice", "receipt",
+)
+_OFF_TOPIC_SIGNALS = (
+    "weather", "joke", "poem", "recipe", "cook", "stock", "crypto",
+    "bitcoin", "football", "soccer", "movie", "song", "lyrics", "game",
+    "homework", "math", "algebra", "code", "python", "javascript",
+    "translate", "capital of", "president", "lottery", "horoscope",
+)
+
+OFF_TOPIC_REPLY = (
+    "I'm Mailkeep, a Gmail assistant — I can only help with your mailbox "
+    "(find, label, archive, draft replies, triage and more). That request "
+    "looks unrelated to email, so I skipped it."
+)
+
+
+def topic_guard_enabled() -> bool:
+    """MAILKEEP_TOPIC_GUARD: on by default; off/0/no/false disables it."""
+    raw = (setting("MAILKEEP_TOPIC_GUARD") or "on").strip().lower()
+    return raw not in ("0", "off", "no", "false")
+
+
+def is_off_topic(text: str) -> bool:
+    """True when the message is clearly not about the mailbox.
+
+    Conservative on purpose: anything naming mail terms, greetings, or
+    short conversational openers passes; only a clear non-mailbox signal
+    or a general-knowledge question with no mailbox term is refused.
+    """
+    import re
+
+    words = text.lower()
+    if any(re.search(rf"\b{re.escape(t)}\b", words) for t in _MAILBOX_TERMS):
+        return False
+    stripped = words.strip()
+    if len(stripped) <= 12:  # "hi", "hello", "thanks", "help"
+        return False
+    if re.search(r"\b(hi|hello|hey|thanks|thank you|help|sorry|yes|no|ok|okay)\b", stripped):
+        return False
+    if any(re.search(rf"\b{re.escape(s)}\b", words) for s in _OFF_TOPIC_SIGNALS):
+        return True
+    if "?" in text and re.match(r"^\s*(what|who|where|when|why|how)\b", stripped):
+        return True
+    return False
