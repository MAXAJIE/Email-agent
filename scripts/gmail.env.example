# Copy to ../.openminion/gmail.env (gitignored) and fill in.
#
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> "Desktop app". Enable the Gmail API in the same project.
# Desktop clients need no redirect URI; the server handles the local callback.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional overrides
# WORKSPACE_MCP_PORT=8001
# WORKSPACE_MCP_CREDENTIALS_DIR=C:/path/inside/this/project/.openminion/gmail/credentials

# --- Google OAuth client type -------------------------------------------
# Mailkeep cannot tell Desktop from Web by the client ID. Set it here, pick it
# in the UI, or paste the downloaded client JSON instead of the two lines above.
# GOOGLE_OAUTH_CLIENT_TYPE=desktop     # desktop | web
# For "web" clients register exactly: http://localhost:8765/oauth/callback

# --- AI agent (OpenMinion) ----------------------------------------------
# Pick provider, model and key here; Mailkeep generates the OpenMinion config.
MAILKEEP_LLM_PROVIDER=openrouter        # openrouter | gemini | portal | openai | custom
MAILKEEP_LLM_MODEL=openai/gpt-4.1-mini  # any model id the provider offers
MAILKEEP_LLM_API_KEY=                   # or OPENROUTER_API_KEY / GEMINI_API_KEY / CORTENSOR_API_KEY
# MAILKEEP_LLM_BASE_URL=                # only for "custom" or a proxy
# MAILKEEP_TRACE=0                      # hide the thinking process in the console

# --- Fix for "Error 403: access_denied" ---------------------------------
# Google only lets Test users of the client's own Cloud project sign in.
# Put that exact address here so the account chooser pre-selects it, then
# run `python -m mailkeep oauth-check` for the console link and checklist.
# MAILKEEP_GMAIL_ACCOUNT=you@gmail.com
