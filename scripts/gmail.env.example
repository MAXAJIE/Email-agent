# Copy to ../.openminion/gmail.env (gitignored) and fill in.
# Also read: scripts/gmail.env, <project>/gmail.env, *.env.txt variants, .env,
# or any path given in the MAILKEEP_ENV_FILE environment variable.
#
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> "Desktop app". Enable the Gmail API in the same project.
# Desktop clients need no redirect URI; the server handles the local callback.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional overrides
# WORKSPACE_MCP_PORT=8001
# WORKSPACE_MCP_CREDENTIALS_DIR=C:/path/inside/this/project/.openminion/gmail/credentials

# --- Google OAuth client type -------------------------------------------
# Mailkeep cannot tell Desktop from Web by the client ID. Set it here, pick it
# in the UI, or paste the downloaded client JSON instead of the two lines above.
# GOOGLE_OAUTH_CLIENT_TYPE=desktop     # desktop | web
# For "web" clients register exactly: http://localhost:8765/oauth/callback

# --- AI agent (OpenMinion) ----------------------------------------------
# Pick provider, model and key here; Mailkeep generates the OpenMinion config.
# These three lines decide which model the agent uses; nothing else is hardcoded.
# Provider: openrouter | gemini | portal | openai | custom
MAILKEEP_LLM_PROVIDER=openrouter
# Model: any model id the provider offers
MAILKEEP_LLM_MODEL=openai/gpt-4.1-mini
# Key: or OPENROUTER_API_KEY / GEMINI_API_KEY / CORTENSOR_API_KEY / OPENAI_API_KEY
MAILKEEP_LLM_API_KEY=
# Base URL: only for "custom" (any OpenAI-compatible endpoint) or a proxy
# MAILKEEP_LLM_BASE_URL=
# Seconds per model call (default 120, portal 480)
# MAILKEEP_LLM_TIMEOUT=120
# MAILKEEP_TRACE=0                      # hide the thinking process in the console

# --- Task-specific models (all optional) --------------------------------
# Each profile can name its own provider, model, key, base URL and timeout.
# A profile with only a MODEL inherits the provider, endpoint and key above.
# Profiles: FAST (quick lookups), REASONING (planning/analysis),
# DRAFT (writing replies), CLASSIFIER (grouping/triage), DEFAULT (everything else).
# MAILKEEP_LLM_FAST_MODEL=openai/gpt-4.1-nano
# MAILKEEP_LLM_REASONING_PROVIDER=gemini
# MAILKEEP_LLM_REASONING_MODEL=gemini-2.5-pro
# MAILKEEP_LLM_REASONING_API_KEY=
# MAILKEEP_LLM_DRAFT_MODEL=
# MAILKEEP_LLM_CLASSIFIER_MODEL=
# MAILKEEP_LLM_DEFAULT_TIMEOUT=

# --- Parallel agents and deadlines --------------------------------------
# MAILKEEP_MAX_AGENTS=3                  # parallel model workers, 1-16
# MAILKEEP_AGENT_TIMEOUT=120             # whole-turn deadline in seconds
# MAILKEEP_GMAIL_TIMEOUT=20              # per Gmail API call in seconds
# MAILKEEP_GMAIL_WORKERS=6               # parallel Gmail reads, 1-16

# --- Action detection ----------------------------------------------------
# Confidence (0-1) that a message asks for a mailbox change. At or above the
# threshold Mailkeep skips the model, shows an execution brief, and waits for
# your Approve. Lower it to catch more phrasings, raise it to ask the model.
# MAILKEEP_ACTION_THRESHOLD=0.6

# --- Topic guard ----------------------------------------------------------
# Refuse questions that are clearly not about your mailbox (weather, jokes,
# homework, ...) instantly, without a model call. on/off, default on.
# MAILKEEP_TOPIC_GUARD=on

# --- Fix for "Error 403: access_denied" ---------------------------------
# Google only lets Test users of the client's own Cloud project sign in.
# Put that exact address here so the account chooser pre-selects it, then
# run `python -m mailkeep oauth-check` for the console link and checklist.
# MAILKEEP_GMAIL_ACCOUNT=you@gmail.com
